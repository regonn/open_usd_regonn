#usda 1.0
(
    defaultPrim = "Street"
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@./street_layout.usda@]
)

over "Street"
{
    def Xform "Billboard" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend payload = @./billboard.usda@
    )
    {
        rel material:binding = </Street/SignMaterial>
    }

    def Material "SignMaterial"
    {
        token outputs:surface.connect = </Street/SignMaterial/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Street/SignMaterial/Image.outputs:rgb>
            token outputs:surface
        }

        def Shader "Image"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/sign.png@
            float2 inputs:st.connect = </Street/SignMaterial/UV.outputs:result>
            float3 outputs:rgb
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}
