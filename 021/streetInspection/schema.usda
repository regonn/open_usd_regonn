#usda 1.0
(
    subLayers = [@usd/schema.usda@]
)

over "GLOBAL" (
    customData = {
        string libraryName = "streetInspection"
        bool skipCodeGeneration = true
    }
) {}

class "StreetInspectionAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    uniform token inspection:status = "pending" (
        allowedTokens = ["pending", "passed"]
    )
    uniform int inspection:intervalDays = 30
}
